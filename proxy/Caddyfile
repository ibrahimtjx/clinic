{
	# Clinic-local certificate authority (SPEC 3.3). Its root certificate is installed once on each client PC.
	pki {
		ca local {
			name "Clinic Local CA"
		}
	}
}

# Plain HTTP only for the clinic CA certificate (first launch of the desktop app, SPEC 2 Rules):
# it cannot be fetched over HTTPS before it is trusted. Its fingerprint is checked by a person.
http://{$SERVER_NAME:localhost} {
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

{$SERVER_NAME:localhost} {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	# Desktop app installer and signed updates (latest.json + installer), copied here by the admin.
	handle_path /desktop/* {
		root * /srv/desktop
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy web:80
	}
}
