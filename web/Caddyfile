{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# SPA: unknown paths serve index.html so deep links work.
	try_files {path} /index.html
	file_server
}
