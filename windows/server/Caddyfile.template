# Clinic server on Windows (generated by setup.ps1 from Caddyfile.template; edit the template).
# Same routes as the Docker setup: proxy/Caddyfile and web/Caddyfile in one file.
{
	admin off
	skip_install_trust # setup.ps1 installs the clinic CA on this PC itself
	pki {
		ca local {
			name "Clinic Local CA"
		}
	}
}

# Plain HTTP only for the clinic CA certificate (first launch of the desktop app).
http://__SERVER_NAME__ {
	handle /ca.crt {
		root * "__DATA__/caddy/caddy/pki/authorities/local"
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

__SERVER_NAME__, localhost {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	handle_path /api/* {
		reverse_proxy 127.0.0.1:__API_PORT__
	}

	handle /ca.crt {
		root * "__DATA__/caddy/caddy/pki/authorities/local"
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	handle_path /desktop/* {
		root * "__DATA__/desktop"
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * "__APP__/web"
		encode zstd gzip
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
