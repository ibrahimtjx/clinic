# Copy to .env and set a long random password before first start.
SERVER_NAME=localhost
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=clinic
# Long random value, e.g. from: openssl rand -hex 32. Keep it secret; same value on the standby.
JWT_SECRET=change-me-to-a-long-random-secret
