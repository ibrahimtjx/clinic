# Copy to .env on each server and fill in. docs/install.md explains every value.
# The clinic system's name on the network, e.g. clinic-server (localhost works on this PC only).
SERVER_NAME=localhost
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=clinic
# Long random value, e.g. from: openssl rand -hex 32. Keep it secret; same value on the standby.
JWT_SECRET=change-me-to-a-long-random-secret

# ---- Backups (SPEC 15.2)
# The backup drive or NAS, mounted on this server (default: ./backups, for trying the system only).
# BACKUP_DIR=/mnt/clinic-backup
# Passphrase file that encrypts every backup. Keep a printed copy in a safe: without it, backups
# cannot be restored. Until it is set, no backups are written and System health says so.
# BACKUP_KEY_FILE=/etc/clinic/backup.key
BACKUP_TIME=0200

# ---- Primary and standby (SPEC 15). Leave empty until the standby is set up.
# This server's name on the health page.
NODE_NAME=server-1
# The OTHER server's LAN address (on the primary: the standby's; on the standby: the primary's).
PEER_IP=
# This server's own LAN address, so the other server can reach its database (only it may log in).
DB_PUBLISH_IP=127.0.0.1
# Same values on both servers.
REPLICATION_PASSWORD=
MONITOR_PASSWORD=
# Optional: an address that moves to whichever server is primary (SERVER_NAME points to it).
SERVICE_IP=
SERVICE_PREFIX=24
SERVICE_IFACE=
